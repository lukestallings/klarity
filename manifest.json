{
  "manifest_version": 3,
  "name": "NewsShield - Credibility Analyzer",
  "version": "1.0",
  "description": "Analyzes online news articles for credibility signals and sensationalism.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://news.google.com/*",
    "https://rdap.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Article"
  }
}
