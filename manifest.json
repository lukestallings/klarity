{
  "manifest_version": 3,
  "name": "Klarity: Content Analysis Engine",
  "version": "1.0",
  "description": "Analyze web content for signals of disinformation using the Nutrition Label UI.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "klarity-logo.png"
  }
}
